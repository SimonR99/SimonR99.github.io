---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class="wrap section-grid">
    <h2 id={`${id}-title`} class="section-title">{title}</h2>
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>
